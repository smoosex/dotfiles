# ─── completion ───────────────────────────────────────────────────────────────
autoload -Uz compinit
zcd="${ZDOTDIR:-$HOME}/.zcompdump"
compinit -d "$zcd"
[[ -f "$zcd.zwc" && "$zcd" -nt "$zcd.zwc" ]] || zcompile "$zcd" 2>/dev/null
unset zcd

# ─── PATH & env ───────────────────────────────────────────────────────────────
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH" ;; esac
export PATH="$HOME/.local/share/tmux/plugins/tmuxifier/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"

export EDITOR="nvim"
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
export LDFLAGS="-L/opt/homebrew/lib"
export CPPFLAGS="-I/opt/homebrew/include"
export OPENCODE_ENABLE_EXA=1
export TMUXIFIER="$HOME/.local/share/tmux/plugins/tmuxifier"
export TMUXIFIER_LAYOUT_PATH="$HOME/.config/tmux/layouts"
export NVM_DIR="$HOME/.nvm"

. "$HOME/.deno/env"

# ─── yazi ─────────────────────────────────────────────────────────────────────
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# ─── secrets (chezmoi encrypted) ──────────────────────────────────────────────
source ~/.config/zsh/env_keys.zsh

# ─── aliases ──────────────────────────────────────────────────────────────────
# NVIM
alias n="nvim"

# GIT
alias gl="git clone"
alias gss="git status"
alias ga="git add"
alias gaa="git add --all"
alias gm="git commit"
alias gmm="git commit -m"
alias gb="git branch"
alias gbr="git branch -r"
alias gk="git checkout"
alias gkb="git checkout -b"
alias gkt="git checkout -t"
alias glg="git log"
alias glgo="git log --oneline"
alias gw="git switch"

# chezmoi
alias cz="cd $HOME/.local/share/chezmoi && nvim"

# LazyGit
alias lg="lazygit"

# eza
alias lse="eza --icons"
alias ll="eza -l --icons"

# tmux
alias tm="tmux"
alias tmi="tmuxifier"

# pi
alias pic="cd $HOME/Documents/pi-chats && pi"

# ─── vi mode ──────────────────────────────────────────────────────────────────
bindkey -v

# jk 从 insert 模式回到 normal 模式
bindkey -M viins 'jk' vi-cmd-mode

# 切换模式时更新光标形状
function zle-keymap-select {
	if [[ $KEYMAP == vicmd ]]; then
		print -nP "\e[2 q"
	else
		print -nP "\e[6 q"
	fi
}
zle -N zle-keymap-select

# 每次新行强制进入 insert 模式并更新光标
function zle-line-init {
	zle -K viins
	zle-keymap-select
}
zle -N zle-line-init

# 补上 viins 下的退格键绑定
bindkey -M viins '^?' backward-delete-char
bindkey -M viins '^H' backward-delete-char

# 替换模式下光标为下划线
__zle_vi_replace_chars_wrapper() {
	print -nP "\e[4 q"
	zle .vi-replace-chars
	print -nP "\e[2 q"
}
zle -N vi-replace-chars __zle_vi_replace_chars_wrapper

# ─── plugins ──────────────────────────────────────────────────────────────────
source ~/.config/zsh/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
source ~/.config/zsh/zsh-autosuggestions/zsh-autosuggestions.zsh
source <(fzf --zsh)

bindkey '\C-y' autosuggest-accept

# ─── bun completions ──────────────────────────────────────────────────────────
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# ─── lazy-loaded tools ────────────────────────────────────────────────────────
# 补全文件开头会 command -v nvm，查不到就直接 return，所以先放个占位
nvm() { : }
. "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"
nvm() {
	unfunction nvm
	\. "/opt/homebrew/opt/nvm/nvm.sh"
	nvm "$@"
}

fuck() {
	unfunction fuck
	eval "$(thefuck --alias)"
	fuck "$@"
}

source "$TMUXIFIER/init.sh"
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
