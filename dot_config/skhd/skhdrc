# ╭──────────────────────────────────────────────────────────╮
# │                   Windows Navigation                     │
# ╰──────────────────────────────────────────────────────────╯
# Window Navigation (through space and display) 
hyper - h : yabai -m window --focus west || skhd -k "ctrl - left" || yabai -m display --focus west
hyper - j : yabai -m window --focus south || yabai -m display --focus south
hyper - k : yabai -m window --focus north || yabai -m display --focus north
hyper - l : yabai -m window --focus east || skhd -k "ctrl - right" || yabai -m display --focus east

# Space Navigation
hyper - 0x29 : yabai -m space --focus recent # Focus the last space
hyper - 0x21 : skhd -k "ctrl - left"
hyper - 0x1E : skhd -k "ctrl - right"
hyper - u : yabai -m space --focus 1
hyper - i : yabai -m space --focus 2
hyper - o : yabai -m space --focus 3
hyper - p : yabai -m space --focus 4
hyper - 5 : yabai -m space --focus 5
hyper - 6 : yabai -m space --focus 6
hyper - 7 : yabai -m space --focus 7
hyper - 8 : yabai -m space --focus 8
hyper - 9 : yabai -m space --focus 9

# Display Navigation
hyper - i : yabai -m display --focus recent
# cmd + shift - p : yabai -m space --focus prev
# cmd + shift - n : yabai -m space --focus next

# ╭──────────────────────────────────────────────────────────╮
# │                    Windows Movement                      │
# ╰──────────────────────────────────────────────────────────╯
# Windows Movement in spaces
lctrl + lshift - h : yabai -m window --swap west || yabai -m window --space prev --focus
lctrl + lshift - j : yabai -m window --swap south
lctrl + lshift - k : yabai -m window --swap north
lctrl + lshift - l : yabai -m window --swap east || yabai -m window --space next --focus

# Mirror Space on X and Y Axis: shift + lalt - {x, y}
lctrl + lshift - x : yabai -m space --mirror x-axis
lctrl + lshift - y : yabai -m space --mirror y-axis

# Toggle split orientation of the selected windows node
lctrl + lshift - s : yabai -m window --toggle split

lctrl + lshift - 0x1B : yabai -m window --sub-layer below
lctrl + lshift - 0x18 : yabai -m window --sub-layer above

# Move window between spaces
lshift + lalt - u : yabai -m window --space 1 --focus
lshift + lalt - i : yabai -m window --space 2 --focus
lshift + lalt - o : yabai -m window --space 3 --focus
lshift + lalt - p : yabai -m window --space 4 --focus
lshift + lalt - 5 : yabai -m window --space 5 --focus
lshift + lalt - 6 : yabai -m window --space 6 --focus
lshift + lalt - 7 : yabai -m window --space 7 --focus
lshift + lalt - 8 : yabai -m window --space 8 --focus
lshift + lalt - 9 : yabai -m window --space 9 --focus

# Change layout of desktop
lctrl + lshift - b : yabai -m config layout bsp
lctrl + lshift - f : yabai -m config layout float

# Send space to last display
lctrl + alt - tab : yabai -m space --display recent --focus
lctrl + shift - tab : yabai -m window --display recent --focus

# ╭──────────────────────────────────────────────────────────╮
# │                     Windows Resize                       │
# ╰──────────────────────────────────────────────────────────╯
# Resize windows
meh - h : yabai -m window --resize right:-100:0 || yabai -m window --resize left:-100:0
meh - j : yabai -m window --resize bottom:0:100 || yabai -m window --resize top:0:100
meh - k : yabai -m window --resize bottom:0:-100 || yabai -m window --resize top:0:-100
meh - l : yabai -m window --resize right:100:0 || yabai -m window --resize left:100:0

# Equalize size of windows: ctrl + lalt - e
meh - e : yabai -m space --balance

# Enable / Disable gaps in current workspace
meh - g : yabai -m space --toggle padding; yabai -m space --toggle gap

# Make window zoom to fullscreen
hyper - return : yabai -m window --toggle zoom-fullscreen

# Make window zoom to parent node 
meh - return : yabai -m window --toggle zoom-parent

# ╭──────────────────────────────────────────────────────────╮
# │                  Float Window Control                    │
# ╰──────────────────────────────────────────────────────────╯
# 1/2 split row
lctrl + lalt - h : yabai -m window --grid 1:2:0:0:1:1
lctrl + lalt - l : yabai -m window --grid 1:2:1:0:1:1

# 1/4 split
lctrl + lalt - u : yabai -m window --grid 2:2:0:0:1:1
lctrl + lalt - i : yabai -m window --grid 2:2:1:0:1:1
lctrl + lalt - j : yabai -m window --grid 2:2:0:1:1:1
lctrl + lalt - k : yabai -m window --grid 2:2:1:1:1:1

# Fullscreen
lctrl + lalt - return : yabai -m window --grid 1:1:0:0:1:1

# Almost full screen
lctrl + lcmd - return : yabai -m window --grid 9:9:1:1:7:7

# ╭──────────────────────────────────────────────────────────╮
# │                         Others                           │
# ╰──────────────────────────────────────────────────────────╯
# Create space on the active display
cmd + shift -c : yabai -m space --create
# Delete focused space and focus first space on display
cmd + shift -d : yabai -m space --destroy

# Float / Unfloat window
lalt - space : yabai -m window --toggle float
